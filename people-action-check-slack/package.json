{
  "name": "people-action-check-slack",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/app.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "status": "node --env-file=.env scripts/status.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/validate.js",
    "validate:slack": "node scripts/validate.js --remote",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "worker:build": "wrangler deploy --dry-run",
    "manifest:http": "node scripts/http-manifest.js",
    "migrate:supabase": "node --env-file=.env scripts/migrate-supabase.js"
  },
  "dependencies": {
    "@slack/bolt": "^4.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "docx": "^9.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
