{
  "display_information": {
    "name": "People Action Check",
    "description": "A private confidence check for people-management decisions",
    "background_color": "#0f1e36"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "People Action Check",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/people-check",
        "description": "Start a private People Action Check",
        "should_escape": false,
        "url": "https://people-action-check.performance-check-in.workers.dev/slack/events"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "im:write",
        "files:read",
        "files:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened"
      ],
      "request_url": "https://people-action-check.performance-check-in.workers.dev/slack/events"
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://people-action-check.performance-check-in.workers.dev/slack/events"
    },
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
